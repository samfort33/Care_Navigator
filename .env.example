# =============================================================================
# CareNavigator — Environment Configuration Template (.env.example)
# Copy this file to .env.local (or .env) and replace placeholders with real values.
# NEVER commit .env or .env.local to version control.
# NEVER prefix server secrets with NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database Configuration (Prisma ORM)
# -----------------------------------------------------------------------------
# Local SQLite default (zero-config local relational persistence):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL + pgvector example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/carenavigator?schema=public"

# -----------------------------------------------------------------------------
# 2. Authentication & Session Security
# -----------------------------------------------------------------------------
# Generate a strong 32+ byte secret via: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-character-random-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. Clinical AI Assessment Engine (Gemini cloud or local Ollama / MedGemma)
# -----------------------------------------------------------------------------
# Provider options: "gemini" (default) | "ollama" (local MedGemma) | "mock" (tests only)
AI_ASSESSMENT_PROVIDER="gemini"
# Set your Google Gemini API key from https://aistudio.google.com/app/apikey
# Leave empty in offline development to use transparent deterministic CDS fallback mode
GEMINI_API_KEY=""
# Recommended production model: "gemini-2.5-flash" (or "gemini-2.5-pro" for complex differentials)
GEMINI_MODEL="gemini-2.5-flash"
# For local MedGemma, install Ollama and run `ollama pull medgemma:4b`, then set:
# AI_ASSESSMENT_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="medgemma:4b"
# Allow time for local model startup; this is intentionally longer than cloud requests.
OLLAMA_TIMEOUT_MS="120000"

# -----------------------------------------------------------------------------
# 4. Private Medical Document & Audio Storage Vault
# -----------------------------------------------------------------------------
# Local private vault outside public/ (served only via authenticated /api/files/[id]):
LOCAL_VAULT_DIR=".local-vault"

# Optional S3-Compatible Private Object Storage (AWS S3 / Cloudflare R2 / Supabase):
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME=""

# -----------------------------------------------------------------------------
# 5. Runtime Environment
# -----------------------------------------------------------------------------
NODE_ENV="development"
